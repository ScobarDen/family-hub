{
  "name": "family-hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "fix": "vp check --fix && vp check --fix",
    "ready": "vp check && vp run -r test && vp run -r build"
