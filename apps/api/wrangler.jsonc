{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-hub-api",
  "main": "src/app/index.ts",
  "tsconfig": "tsconfig.worker.json",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-hub",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "FamilyLive" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyLive"] }],
  "ai": {
    "binding": "AI",
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://scobarden.github.io",
    "MINI_APP_URL": "https://scobarden.github.io/family-hub/",
    "AI_COMMAND_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_COMMAND_MODEL_FALLBACK": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "AI_SPEECH_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "AI_COMMANDS_PER_FAMILY_DAY": "30",
  },
  "secrets": {
    "required": ["BOT_TOKEN", "JWT_SECRET", "WEBHOOK_SECRET", "OPERATOR_TELEGRAM_ID"],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
}
