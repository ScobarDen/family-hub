{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-hub-api",
  "main": "src/app/index.ts",
  "tsconfig": "tsconfig.worker.json",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-hub",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "FamilyLive" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyLive"] }],
  "vars": {
    "ALLOWED_ORIGINS": "https://scobarden.github.io",
    "MINI_APP_URL": "https://scobarden.github.io/family-hub/",
    "VAPID_SUBJECT": "https://scobarden.github.io/family-hub/",
  },
  "secrets": {
    "required": [
      "BOT_TOKEN",
      "JWT_SECRET",
      "WEBHOOK_SECRET",
      "OPERATOR_TELEGRAM_ID",
      "VAPID_PUBLIC_KEY",
      "VAPID_PRIVATE_KEY",
    ],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
}
